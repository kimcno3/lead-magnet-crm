# docker compose와 backend가 읽는 환경 변수. 복사해서 .env로 쓴다: cp .env.example .env
# 실제 시크릿은 .env에만 두고 커밋하지 않는다.

# PostgreSQL
POSTGRES_DB=leadmagnet
POSTGRES_USER=leadmagnet
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# backend 포트: admin 출처(관리자 API), public 출처(공개 폼·공개 API)
ADMIN_PORT=8080
PUBLIC_PORT=8081

# admin-web(관리자 화면) 호스트 포트
ADMIN_WEB_PORT=5173

# 기동 시 만들 운영자 계정 (ADR 0009). 비밀번호는 12자 이상.
# 둘 다 비우면 시드를 건너뛰고, 하나만 채우면 backend 기동이 실패한다.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me-local-only

# 관리자 인증 (ADR 0003)
# access token HS256 서명 키. 필수이며 UTF-8 32바이트 이상이어야 한다(없거나 짧으면 backend 기동 실패).
# 아래 자리표시 값은 일부러 짧아서 그대로 두면 기동이 실패한다. 반드시 새로 만들어 바꾼다: openssl rand -base64 48
JWT_SECRET=change-me
# 관리자 API CORS가 허용하는 유일한 출처(admin-web 주소)
ADMIN_ORIGIN=http://localhost:5173
# refresh 쿠키(lm_refresh)와 방문자 쿠키(lm_vid)의 Secure 속성. 로컬 http에서는 false, https 배포에서는 true.
COOKIE_SECURE=false

# 신청자 개인정보 암호화 (ADR 0015). 둘 다 필수이고 각각 base64로 인코딩한 32바이트이며 서로 달라야 한다.
# LEAD_ENC_KEY는 이름·전화번호·이메일 AES-256-GCM 암호화 키, LEAD_HMAC_KEY는 중복 판정용 HMAC-SHA256 키다.
# 아래 자리표시 값은 base64 32바이트가 아니라서 그대로 두면 backend 기동이 실패한다. 각각 새로 만든다: openssl rand -base64 32
# 한 번 정한 키를 바꾸거나 잃어버리면 이미 저장한 신청자 정보를 읽을 수 없다(키 교체 절차는 아직 없다). 따로 안전하게 보관한다.
LEAD_ENC_KEY=change-me
LEAD_HMAC_KEY=change-me

# 공개 폼 작성 시간 토큰(ft) HMAC-SHA256 서명 키 (ADR 0019). 필수이고 base64로 인코딩한 32바이트여야 한다.
# 아래 자리표시 값은 base64 32바이트가 아니라서 그대로 두면 backend 기동이 실패한다. 새로 만든다: openssl rand -base64 32
# 개인정보 키와 다른 값으로 둔다. 바꾸면 열려 있던 공개 폼 페이지의 토큰만 무효가 된다(새로 고치면 된다).
FORM_TOKEN_KEY=change-me

# 배포 링크 URL의 앞부분. 응답의 url은 {PUBLIC_BASE_URL}/l/{code} (ADR 0006). 운영에서는 public 출처의 실제 주소로 바꾼다.
# docker compose는 같은 값을 admin-web 빌드 인자 VITE_PUBLIC_BASE_URL로도 넘긴다(관리자 화면의 공개 폼 URL 표시).
# npm run dev로 띄울 때는 admin-web에서 VITE_PUBLIC_BASE_URL 환경 변수로 바꿀 수 있다(기본 http://localhost:8081).
PUBLIC_BASE_URL=http://localhost:8081
