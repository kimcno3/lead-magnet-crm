# docker compose와 backend가 읽는 환경 변수. 복사해서 .env로 쓴다: cp .env.example .env
# 실제 시크릿은 .env에만 두고 커밋하지 않는다.

# PostgreSQL
POSTGRES_DB=leadmagnet
POSTGRES_USER=leadmagnet
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# backend 포트: admin 출처(관리자 API), public 출처(공개 폼·공개 API)
ADMIN_PORT=8080
PUBLIC_PORT=8081

# admin-web(관리자 화면) 호스트 포트
ADMIN_WEB_PORT=5173

# 기동 시 만들 운영자 계정 (ADR 0009). 비밀번호는 12자 이상.
# 둘 다 비우면 시드를 건너뛰고, 하나만 채우면 backend 기동이 실패한다.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me-local-only

# 관리자 인증 (ADR 0003)
# access token HS256 서명 키. 필수이며 UTF-8 32바이트 이상이어야 한다(없거나 짧으면 backend 기동 실패).
# 아래 자리표시 값은 일부러 짧아서 그대로 두면 기동이 실패한다. 반드시 새로 만들어 바꾼다: openssl rand -base64 48
JWT_SECRET=change-me
# 관리자 API CORS가 허용하는 유일한 출처(admin-web 주소)
ADMIN_ORIGIN=http://localhost:5173
# refresh 쿠키(lm_refresh)와 방문자 쿠키(lm_vid)의 Secure 속성. 로컬 http에서는 false, https 배포에서는 true.
COOKIE_SECURE=false

# 배포 링크 URL의 앞부분. 응답의 url은 {PUBLIC_BASE_URL}/l/{code} (ADR 0006). 운영에서는 public 출처의 실제 주소로 바꾼다.
PUBLIC_BASE_URL=http://localhost:8081
